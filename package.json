{
  "name": "astral-desk",
  "version": "1.0.0",
  "type": "module",
  "description": "AstralDesk - ACG AI Desktop Companion with AstrBot & DeepSeek R1 Integration",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:exe": "vite build && electron-builder --win",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.antigravity.astraldesk",
    "productName": "AstralDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "sign": null,
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "keywords": [
    "ai",
    "deepseek",
    "astrbot",
    "acg",
    "desktop-companion",
    "electron",
    "vue3"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "lucide-vue-next": "^0.475.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.2"
  }
}
